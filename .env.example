# Firebase-Service-Account für die scripts/ (Export aus Claude-Artefakten,
# Sync Markdown <-> Firestore). Nur serverseitig genutzt, nie im Browser.
# Kompletten Inhalt der Service-Account-JSON (Firebase Console -> Projekt-
# einstellungen -> Dienstkonten -> Neuen privaten Schlüssel generieren) hier
# als einzeiligen String eintragen.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
